# Render sets PORT automatically — don't override
# PORT=3000

# Paths — defaults work for Render's project directory
AUTH_DIR=./auth_state
DB_PATH=./data/whatsapp.db
MEDIA_DIR=./data/media

# Optional: protect endpoints with API key
# Send as X-API-Key header or ?api_key= query param
API_KEY=

# Log level: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=silent
