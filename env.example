# PostgreSQL connection string
# Render auto-sets this when you link a database via render.yaml
# For local dev, point this to your local PostgreSQL instance
DATABASE_URL=

# Server port (Render sets this automatically)
PORT=3000

# Where Baileys stores WhatsApp auth credentials
AUTH_DIR=./auth_state

# Where downloaded media files are cached
MEDIA_DIR=./data/media

# Optional: protect endpoints with API key (send as X-API-Key header)
API_KEY=

# Log level: silent, fatal, error, warn, info, debug, trace
LOG_LEVEL=silent
