DATABASE_URL=

PORT=3000

AUTH_DIR=./auth_state

MEDIA_DIR=./data/media

UPLOAD_TMP_DIR=./data/tmp

MAX_UPLOAD_MB=25
MAX_UPLOAD_TOTAL_MB=50
MAX_UPLOAD_FILES=8

# JSON body limit 
JSON_BODY_LIMIT=20mb

# Optional: require X-API-Key header or ?api_key= query on all endpoints except
# /health, /qr-image 
API_KEY=

# Optional
RENDER_EXTERNAL_URL=

# Pino/Baileys log level: silent, error, warn, info, debug
LOG_LEVEL=silent
